# Grafana Cloud Metrics — read-only, server-side only.
# Use a separate access-policy token scoped to `metrics:read`. Do not reuse
# the Alloy remote-write token. Never prefix these with NEXT_PUBLIC_.

# The Metrics instance query base URL from the Grafana Cloud Portal
# (not the /api/prom/push remote-write endpoint).
GRAFANA_METRICS_QUERY_URL=
# The Metrics instance ID (used as the Basic auth username).
GRAFANA_METRICS_USER=
# Access-policy token with metrics:read scope (used as the Basic auth password).
GRAFANA_METRICS_READ_TOKEN=
